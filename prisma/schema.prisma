generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model OperatorRole {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  permissions Json       @default("[]")
  createdAt   DateTime   @default(now()) @map("created_at")
  operators   Operator[]

  @@map("operator_roles")
}

model Operator {
  id              String           @id @default(cuid())
  name            String
  nickname        String?
  email           String           @unique
  passwordHash    String           @map("password_hash")
  roleId          String           @map("role_id")
  role            OperatorRole     @relation(fields: [roleId], references: [id])
  avatarUrl       String?          @map("avatar_url")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  attendances     Attendance[]
  racs            RAC[]
  occurrences     Occurrence[]
  subjectTeachers SubjectTeacher[]
  teacherSubjects TeacherSubject[]
  equipmentBookings EquipmentBooking[]
  spaceBookings   SpaceBooking[]
  
  // PDT Relations
  pdtClasses      ClassGroup[]     @relation("PDTTeacher")
  pdtAttendances  PDTAttendanceRecord[]
  pdtCouncils     PDTClassCouncil[]
  
  // Estagios
  internshipsGuided StudentInternship[]

  // Liberacao de Alunos e Busca Ativa
  exitPasses        StudentExitPass[]
  buscaAtivaActions BuscaAtivaAction[]

  @@map("operators")
}

model Student {
  id                 String       @id @default(cuid())
  registrationNumber String       @unique @map("registration_number")
  name               String
  cpf                String?
  birthDate          DateTime?    @map("birth_date")
  photoUrl           String?      @map("photo_url")
  guardianName       String?      @map("guardian_name")
  guardianPhone      String?      @map("guardian_phone")
  address            String?
  city               String?
  neighborhood       String?
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  enrollments        Enrollment[]
  pdtDossier         PDTStudentDossier?
  pdtAttendances     PDTAttendanceRecord[]
  internships        StudentInternship[]
  exitPasses         StudentExitPass[]
  buscaAtivaActions  BuscaAtivaAction[]

  @@map("students")
}

model SchoolYear {
  id        String       @id @default(cuid())
  year      Int          @unique
  isCurrent Boolean      @default(false) @map("is_current")
  startDate DateTime?    @map("start_date")
  endDate   DateTime?    @map("end_date")
  classes   ClassGroup[]

  @@map("school_years")
}

model Grade {
  id          String       @id @default(cuid())
  name        String       @unique
  level       String       @default("MEDIO")
  orderNumber Int          @map("order_number")
  classes     ClassGroup[]

  @@map("grades")
}

model Subject {
  id              String           @id @default(cuid())
  name            String           @unique
  abbreviation    String?
  isActive        Boolean          @default(true) @map("is_active")
  attendances     Attendance[]
  subjectTeachers SubjectTeacher[]
  teacherSubjects TeacherSubject[]

  @@map("subjects")
}

model TeacherSubject {
  id         String   @id @default(cuid())
  operatorId String   @map("operator_id")
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  subjectId  String   @map("subject_id")
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([operatorId, subjectId])
  @@map("teacher_subjects")
}

model ClassGroup {
  id              String           @id @default(cuid())
  name            String
  shift           String
  gradeId         String           @map("grade_id")
  grade           Grade            @relation(fields: [gradeId], references: [id])
  schoolYearId    String           @map("school_year_id")
  schoolYear      SchoolYear       @relation(fields: [schoolYearId], references: [id])
  
  // PDT Teacher assigned to this class
  pdtId           String?          @map("pdt_id")
  pdtTeacher      Operator?        @relation("PDTTeacher", fields: [pdtId], references: [id])
  
  enrollments     Enrollment[]
  subjectTeachers SubjectTeacher[]
  pdtCouncils     PDTClassCouncil[]

  @@unique([name, gradeId, schoolYearId])
  @@map("class_groups")
}

model SubjectTeacher {
  id           String     @id @default(cuid())
  subjectId    String     @map("subject_id")
  subject      Subject    @relation(fields: [subjectId], references: [id])
  operatorId   String     @map("operator_id")
  operator     Operator   @relation(fields: [operatorId], references: [id])
  classGroupId String     @map("class_group_id")
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  @@unique([subjectId, classGroupId])
  @@map("subject_teachers")
}

model Enrollment {
  id           String      @id @default(cuid())
  studentId    String      @map("student_id")
  student      Student     @relation(fields: [studentId], references: [id])
  classGroupId String      @map("class_group_id")
  classGroup   ClassGroup  @relation(fields: [classGroupId], references: [id])
  status       String      @default("ATIVO")
  enrolledAt   DateTime    @default(now()) @map("enrolled_at")

  attendances Attendance[]
  racs        RAC[]
  occurrences Occurrence[]

  @@unique([studentId, classGroupId])
  @@map("enrollments")
}

model Attendance {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  operatorId   String     @map("operator_id")
  operator     Operator   @relation(fields: [operatorId], references: [id])
  subjectId    String     @map("subject_id")
  subject      Subject    @relation(fields: [subjectId], references: [id])
  date         DateTime   @db.Date
  status       String
  observation  String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([enrollmentId, date, subjectId])
  @@map("attendances")
}

model RACType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  severity    String  @default("LEVE")
  isActive    Boolean @default(true) @map("is_active")
  racs        RAC[]

  @@map("rac_types")
}

model RAC {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  operatorId   String     @map("operator_id")
  operator     Operator   @relation(fields: [operatorId], references: [id])
  racTypeId    String     @map("rac_type_id")
  racType      RACType    @relation(fields: [racTypeId], references: [id])
  date         DateTime
  description  String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("racs")
}

model OccurrenceType {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  severity    String       @default("LEVE")
  isActive    Boolean      @default(true) @map("is_active")
  occurrences Occurrence[]

  @@map("occurrence_types")
}

model Occurrence {
  id               String         @id @default(cuid())
  enrollmentId     String         @map("enrollment_id")
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id])
  operatorId       String         @map("operator_id")
  operator         Operator       @relation(fields: [operatorId], references: [id])
  occurrenceTypeId String         @map("occurrence_type_id")
  occurrenceType   OccurrenceType @relation(fields: [occurrenceTypeId], references: [id])
  date             DateTime
  description      String?
  actionTaken      String?        @map("action_taken")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("occurrences")
}

// -----------------------------------------------------------------------------
// MÓDULO: IMOBILIZADOS & RESERVAS (Equipamentos e Espaços Pedagógicos)
// -----------------------------------------------------------------------------

model Equipment {
  id          String             @id @default(cuid())
  name        String
  code        String             @unique
  category    String             @default("Projetor")
  brand       String?
  model       String?
  location    String             @default("Sala dos Professores")
  status      String             @default("DISPONIVEL")
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  bookings    EquipmentBooking[]

  @@map("equipments")
}

model EquipmentBooking {
  id             String    @id @default(cuid())
  equipmentId    String    @map("equipment_id")
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  operatorId     String    @map("operator_id")
  operator       Operator  @relation(fields: [operatorId], references: [id])
  date           DateTime  @db.Date
  classNumber    Int       @map("class_number")
  classGroupName String?   @map("class_group_name")
  purpose        String?
  status         String    @default("RESERVADO")
  checkedOutAt   DateTime? @map("checked_out_at")
  checkedInAt    DateTime? @map("checked_in_at")
  returnNotes    String?   @map("return_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("equipment_bookings")
}

model SchoolSpace {
  id          String         @id @default(cuid())
  name        String         @unique
  code        String?        @unique
  category    String         @default("Laboratório") // LEI, Ciências, Biblioteca, Auditório, Quadra
  capacity    Int            @default(40)
  location    String         @default("Bloco Principal")
  resources   String?        // ex: 35 Computadores, Projetor, Ar Condicionado
  status      String         @default("DISPONIVEL")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  bookings    SpaceBooking[]

  @@map("school_spaces")
}

model SpaceBooking {
  id             String      @id @default(cuid())
  spaceId        String      @map("space_id")
  space          SchoolSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  operatorId     String      @map("operator_id")
  operator       Operator    @relation(fields: [operatorId], references: [id])
  date           DateTime    @db.Date
  classNumber    Int         @map("class_number") // 1ª Aula, 2ª Aula...
  classGroupName String?     @map("class_group_name")
  purpose        String      // ex: Aula prática de Biologia, Pesquisa no LEI
  status         String      @default("CONFIRMADO") // CONFIRMADO, CANCELADO, CONCLUIDO
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("space_bookings")
}

// -----------------------------------------------------------------------------
// MÓDULO: PDT (Projeto Professor Diretor de Turma - SEDUC Ceará)
// -----------------------------------------------------------------------------

model PDTStudentDossier {
  id                   String   @id @default(cuid())
  studentId            String   @unique @map("student_id")
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Perfil Sociofamiliar e Saúde
  livesWith            String?  @map("lives_with") // Pais, Avo, Mae, etc.
  siblingsCount        Int      @default(0) @map("siblings_count")
  transportMethod      String?  @map("transport_method") // Ônibus Escolar, A pé, Moto...
  healthConditions     String?  @map("health_conditions") // Alergias, medicamentos, necessidades
  familyIncomeBracket  String?  @map("family_income_bracket")
  
  // Acompanhamento Pedagógico e Projeto de Vida
  strengths            String?  // Pontos fortes do estudante
  challenges           String?  // Dificuldades de aprendizagem
  lifeProjectGoals     String?  @map("life_project_goals") // Sonho profissional / Projeto de Vida
  observations         String?
  
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("pdt_student_dossiers")
}

model PDTAttendanceRecord {
  id              String   @id @default(cuid())
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  operatorId      String   @map("operator_id") // PDT ou Coordenador
  operator        Operator @relation(fields: [operatorId], references: [id])
  date            DateTime @default(now())
  guardianName    String   @map("guardian_name")
  reason          String   // Motivo: Rendimento, Faltas, Comportamento, Elogio
  summary         String   // Resumo da conversa e deliberações
  actionPlan      String?  @map("action_plan") // Compromissos assumidos
  status          String   @default("CONCLUIDO") // AGENDADO, CONCLUIDO
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("pdt_attendance_records")
}

model PDTClassCouncil {
  id            String     @id @default(cuid())
  classGroupId  String     @map("class_group_id")
  classGroup    ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  operatorId    String     @map("operator_id") // PDT da turma
  operator      Operator   @relation(fields: [operatorId], references: [id])
  bimester      Int        @default(1) // 1º, 2º, 3º, 4º Bimestre
  date          DateTime   @default(now())
  highlights    String?    // Destaques positivos da turma
  concerns      String?    // Alunos com risco de reprovação / infrequência
  interventions String?    // Ações de intervenção pactuadas com os professores
  minutes       String?    // Texto completo da Ata do Conselho
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("pdt_class_councils")
}

// -----------------------------------------------------------------------------
// MÓDULO: ESTÁGIO SUPERVISIONADO (Exclusivo EEEP / Cursos Técnicos)
// -----------------------------------------------------------------------------

model InternshipCompany {
  id             String              @id @default(cuid())
  corporateName  String              @map("corporate_name") // Razão Social
  tradeName      String              @map("trade_name") // Nome Fantasia
  cnpj           String?             @unique
  contactPerson  String              @map("contact_person")
  phone          String?
  email          String?
  address        String?
  city           String              @default("Sobral")
  industryArea   String              @default("Tecnologia e Serviços") @map("industry_area")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  internships    StudentInternship[]

  @@map("internship_companies")
}

model StudentInternship {
  id             String            @id @default(cuid())
  studentId      String            @map("student_id")
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyId      String            @map("company_id")
  company        InternshipCompany @relation(fields: [companyId], references: [id])
  advisorId      String            @map("advisor_id") // Professor orientador de estágio
  advisor        Operator          @relation(fields: [advisorId], references: [id])
  courseName     String            @default("Técnico em Informática") @map("course_name")
  totalHours     Int               @default(400) @map("total_hours")
  completedHours Int               @default(0) @map("completed_hours")
  startDate      DateTime          @map("start_date") @db.Date
  endDate        DateTime?         @map("end_date") @db.Date
  status         String            @default("EM_ANDAMENTO") // EM_ANDAMENTO, CONCLUIDO, DESLIGADO
  supervisorName String?           @map("supervisor_name") // Supervisor na empresa
  finalGrade     Float?            @map("final_grade") // Nota final do estágio
  evaluationNote String?           @map("evaluation_note")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  logs           InternshipLog[]

  @@map("student_internships")
}

model InternshipLog {
  id           String            @id @default(cuid())
  internshipId String            @map("internship_id")
  internship   StudentInternship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  monthYear    String            @map("month_year") // ex: "08/2026"
  hoursLogged  Int               @map("hours_logged")
  activities   String            // Descrição das atividades desenvolvidas no mês
  feedback     String?           // Parecer do orientador ou supervisor
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("internship_logs")
}

// -----------------------------------------------------------------------------
// MÓDULO: LIBERAÇÃO DE ALUNOS (Passe de Saída Antecipada / Portaria)
// -----------------------------------------------------------------------------

model StudentExitPass {
  id              String    @id @default(cuid())
  studentId       String    @map("student_id")
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  operatorId      String    @map("operator_id") // Operador que registrou/autorizou
  operator        Operator  @relation(fields: [operatorId], references: [id])
  type            String    @default("SAIDA_ANTECIPADA") // SAIDA_ANTECIPADA, ENTRADA_TARDIA, LIBERACAO_TURMA
  date            DateTime  @default(now()) @db.Date
  time            String    // Horário (ex: "10:30")
  reason          String    // Motivo: Consulta médica, Assunto familiar, Mal-estar, etc.
  authorizedBy    String    @map("authorized_by") // Responsável ou coordenação que autorizou
  accompaniedBy   String?   @map("accompanied_by") // Quem acompanhou na saída
  guardianContact String?   @map("guardian_contact") // Telefone de contato
  status          String    @default("LIBERADO") // LIBERADO, CANCELADO
  observation     String?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("student_exit_passes")
}

// -----------------------------------------------------------------------------
// MÓDULO: CALENDÁRIO LETIVO / EVENTOS ESCOLARES (SEDUC Ceará)
// -----------------------------------------------------------------------------

model SchoolEvent {
  id             String    @id @default(cuid())
  schoolYearId   String?   @map("school_year_id")
  title          String
  description    String?
  type           String    @default("EVENTO") // FERIADO, RECESSO, LETIVO, SABADO_LETIVO, CONSELHO, PROVA, EVENTO, BIMESTRE
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isNonSchoolDay Boolean   @default(false) @map("is_non_school_day") // Dia não letivo
  bimester       Int?      // 1, 2, 3, 4
  color          String?   @default("blue") // blue, red, green, amber, purple
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("school_events")
}

// -----------------------------------------------------------------------------
// MÓDULO: BUSCA ATIVA ESCOLAR (Acompanhamento e Intervenção de Infrequência)
// -----------------------------------------------------------------------------

model BuscaAtivaAction {
  id              String    @id @default(cuid())
  studentId       String    @map("student_id")
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  operatorId      String    @map("operator_id")
  operator        Operator  @relation(fields: [operatorId], references: [id])
  date            DateTime  @default(now())
  contactType     String    @default("WHATSAPP") // LIGACAO, WHATSAPP, VISITA_DOMICILIAR, REUNIAO_PRESENCIAL, CONSELHO_TUTELAR
  contactPerson   String    @map("contact_person") // Nome do responsável contatado
  phoneUsed       String?   @map("phone_used")
  summary         String    // Resumo da conversa / visita
  reasonForAbsence String?  @map("reason_for_absence") // Motivo das faltas
  returnDate      DateTime? @map("return_date") @db.Date // Previsão de retorno
  status          String    @default("EM_ANDAMENTO") // EM_ANDAMENTO, RETORNOU, VISITA_NECESSARIA, CONSELHO_TUTELAR, TRANSFERIDO
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("busca_ativa_actions")
}
